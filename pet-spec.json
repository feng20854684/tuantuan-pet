{
  "schemaVersion": 5,
  "app": {
    "name": "团团桌宠",
    "appId": "com.tuantuan.pet",
    "version": "1.0.0",
    "language": "zh-CN"
  },
  "targets": {
    "windows": {
      "enabled": true,
      "arch": "x64"
    },
    "macos": {
      "enabled": false,
      "arch": "current"
    }
  },
  "character": {
    "inputType": "text",
    "coreAsset": "core-ip.png",
    "displayName": "团团",
    "archetype": "cat",
    "personality": [
      "贪吃",
      "慵懒",
      "黏人",
      "好奇心旺盛"
    ],
    "preserveTraits": [
      "圆滚滚橘白相间胖身体",
      "大圆眼睛",
      "粉色小鼻子",
      "橙色虎斑条纹",
      "白色肚皮和爪子",
      "蓬松大尾巴"
    ],
    "style": "balanced-cartoon",
    "mirrorSafe": false
  },
  "assetPipeline": {
    "backgroundMode": "semantic-cutout",
    "segmentationBackend": "auto",
    "subjectKind": "illustration",
    "generationBackground": "transparent-grid",
    "backgroundTolerance": 24,
    "edgeFeather": 8,
    "safeMargin": 32,
    "targetOccupancy": 0.76
  },
  "experience": {
    "theme": {
      "primary": "#E8913A",
      "accent": "#F4A460",
      "background": "#FFF5EB",
      "surface": "#FFFFFF",
      "text": "#4A3728",
      "muted": "#B89B7A",
      "cornerRadius": 20
    },
    "petSizing": {
      "baseWindowPx": 220,
      "defaultScale": 0.8
    },
    "interactions": [
      {
        "id": "pet-head",
        "emoji": "😻",
        "label": "摸头",
        "stateId": "pet-head",
        "durationMs": 1500,
        "affectionGain": 3,
        "feedback": [
          "舒服～再摸一会儿",
          "呼噜呼噜...",
          "团团最喜欢你了！"
        ]
      },
      {
        "id": "feed-fish",
        "emoji": "🐟",
        "label": "喂小鱼干",
        "stateId": "feed-fish",
        "durationMs": 1800,
        "affectionGain": 5,
        "feedback": [
          "小鱼干！万岁！",
          "吧唧吧唧...真好吃",
          "还要还要！"
        ]
      },
      {
        "id": "play-wand",
        "emoji": "🪶",
        "label": "逗猫棒",
        "stateId": "play-wand",
        "durationMs": 2000,
        "affectionGain": 4,
        "feedback": [
          "看我抓到你！",
          "扑！",
          "再来一局！"
        ]
      }
    ]
  },
  "motion": {
    "breathing": {
      "enabled": true,
      "periodMs": 3200,
      "scaleX": 0.01,
      "scaleY": 0.025
    },
    "squashStretch": {
      "enabled": true,
      "durationMs": 280,
      "intensity": 0.08
    },
    "idleIntervalMs": {
      "min": 5000,
      "max": 12000
    }
  },
  "features": {
    "transparentWindow": true,
    "drag": true,
    "tray": true,
    "edgeSnap": true,
    "reminders": true,
    "interactions": true,
    "relationship": true,
    "filePocket": false,
    "dashboard": true,
    "typingReaction": false,
    "autonomousMovement": false
  },
  "states": [
    {
      "id": "idle",
      "triggers": [
        "app:start",
        "ambient:idle"
      ],
      "frames": [
        "idle-1.png",
        "idle-2.png",
        "idle-3.png",
        "idle-4.png",
        "idle-5.png"
